package-as: GlassChat

enable-nolib-creation: no

# One CurseForge project, one addon folder per plugin. WoW only discovers
# addons as top-level folders under Interface/AddOns, so plugins can't ship
# nested inside GlassChat/: the packager moves them out (GlassPanel's and
# AltStable's pattern). The destination is the plugin's TOC name. Add a line
# here with each new Plugins/<Name>; tests/test_toc.lua checks.
move-folders:
  GlassChat/Plugins/SpamIgnore: GlassChatSpamIgnore

# The glass material. Pinned, never `tag: latest` (the packager picks the
# newest tag by creation date and falls back to the branch HEAD). Bump the pin
# only in a release made anyway: players get library fixes earlier through
# whichever glass addon ships the newest copy, since LibStub runs that one.
# CI reads the pin from here, so it is written once.
#
# No comment on a value line: the packager's YAML reader keeps it as part of
# the value (measured in GlassUnitFrames #64).
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r2
  # Own-account messaging (Spam & Ignore's list copy, #33). r3 (6c888c5):
  # faster hashing and a first-run fix; no API change from r2, the commit the
  # owner's two-account check passed on.
  Libs/LibAccountSync-1.0:
    url: https://github.com/Spotnick2/LibAccountSync
    tag: r3

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# YAML list, not markdown bullets. Every pattern matches the WHOLE path from
# the package root (release.sh's match_pattern is a shell `case`), so the
# top-level names below never reach inside Libs/: Libs/LibGlass-1.0/LICENSE
# ships (MIT).
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  # The library's own .pkgmeta ignores these, and the BigWigs packager honours
  # that; CurseForge's packager, which builds the release, does NOT (measured
  # in Priestly's published zip, Priestly #53). So they are named from here.
  # CI asserts what the zip holds under Libs/LibGlass-1.0/.
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
  # LibAccountSync's own non-shipped paths. Its ChatThrottleLib/ and LibStub/
  # ship: its XML loads them. Tools/ holds its in-game probe.
  - Libs/LibAccountSync-1.0/tests
  - Libs/LibAccountSync-1.0/docs
  - Libs/LibAccountSync-1.0/Tools
  - Libs/LibAccountSync-1.0/CLAUDE.md
  - Libs/LibAccountSync-1.0/README.md
